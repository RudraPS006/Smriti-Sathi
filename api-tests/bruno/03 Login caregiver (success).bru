meta {
  name: 03 Login caregiver (success)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{caregiverEmail}}",
    "password": "{{demoPassword}}"
  }
}

script:post-response {
  // keep the JWT for the next requests
  bru.setVar("token", res.body.token);
}

assert {
  res.status: eq 200
  res.body.user.role: eq caregiver
}
